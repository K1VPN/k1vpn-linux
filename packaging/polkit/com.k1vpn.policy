<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>K1VPN</vendor>
  <vendor_url>https://k1vpn.com/</vendor_url>

  <action id="com.k1vpn.network-control">
    <description>Control the K1VPN network connection</description>
    <message>Authentication is required to change the K1VPN network connection</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
